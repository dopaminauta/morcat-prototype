# Copiá este archivo a .env y completá los valores.
#   cp .env.example .env
#
# .env está en .gitignore y NUNCA se commitea: contiene una clave privada.
# Cada persona genera el suyo con SU propia wallet. No se comparte por chat,
# ni por mail, ni se manda el archivo armado.

# ─── Obligatorio para deployar ──────────────────────────────────────────────

# Clave privada de la wallet que deploya, sin el prefijo 0x.
# En MetaMask: ⋮ → Detalles de la cuenta → Mostrar clave privada.
# Usá una wallet DESCARTABLE, exclusiva para testnet. Nunca una con fondos reales.
PRIVATE_KEY=

# ─── Opcionales ─────────────────────────────────────────────────────────────

# RPC de Sepolia. El default público (https://rpc.sepolia.org) anda pero es
# inestable. Para deployar en serio conviene uno propio:
#   Alchemy  → https://dashboard.alchemy.com  (gratis)
#   Infura   → https://app.infura.io          (gratis)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# API key de Etherscan, para `npx hardhat verify`.
# Se saca gratis en https://etherscan.io/myapikey
# Sin esto el deploy funciona igual, pero los contratos quedan sin código
# fuente publicado y nadie puede auditarlos desde el explorador.
ETHERSCAN_API_KEY=

# ─── Sólo para scripts/interact.ts ──────────────────────────────────────────

# Address que recibe los tokens (default: la wallet del deployer)
HOLDER=

# ONCHAINID del holder — tiene que ser un contrato Identity.
# Si lo dejás vacío usa un placeholder que NO es un contrato: alcanza para
# probar el flujo mientras el ClaimTopicsRegistry esté vacío, nada más.
ONCHAIN_ID=

# Cantidad a mintear, en unidades enteras (default: 1000)
AMOUNT=
