    "@nomicfoundation/hardhat-verify": "^3.0.22",
    "@openzeppelin/contracts": "^4.8.3",
    "@openzeppelin/contracts-upgradeable": "^4.8.3",
    "@tokenysolutions/t-rex": "^4.1.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "hardhat": "^3.12.0"
  },
  "allowScripts": {
    "keccak@3.0.4": true,
    "secp256k1@4.0.4": true,
